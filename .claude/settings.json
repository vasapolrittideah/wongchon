{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/git_guard.py\""
          }
        ]
      }
    ]
  }
}
